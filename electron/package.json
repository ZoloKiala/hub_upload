{
  "name": "iwmi-hub-uploader",
  "productName": "IWMI Hub Uploader",
  "version": "0.1.0",
  "description": "Desktop uploader for the IWMIHQ Hugging Face organization",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "International Water Management Institute (IWMI)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.iwmi.hubuploader",
    "productName": "IWMI Hub Uploader",
    "artifactName": "IWMI-Hub-Uploader-Setup-${version}.${ext}",
    "directories": { "output": "../dist-app" },
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "extraResources": [
      { "from": "../dist-backend/hub-backend.exe", "to": "hub-backend.exe" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IWMI Hub Uploader"
    }
  }
}
